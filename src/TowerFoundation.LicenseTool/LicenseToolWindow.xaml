<Window x:Class="TowerFoundation.LicenseTool.LicenseToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="塔基智设 · 授权工具" Width="860" Height="820" MinWidth="720" MinHeight="660"
        Icon="Assets/tower-foundation.ico" WindowStartupLocation="CenterScreen" Loaded="OnLoaded">
    <Grid Background="#F5F7FB">
        <Grid.RowDefinitions><RowDefinition Height="104"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
        <Border Background="{StaticResource Brand}">
            <Grid Margin="26,16"><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="54" Height="54" Padding="5" Background="White" CornerRadius="14">
                    <Image Source="Assets/tower-foundation-logo.png" Stretch="Uniform"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Foreground="White" FontSize="24" FontWeight="Bold"/>
                    <TextBlock x:Name="SubtitleText" Margin="0,5,0,0" Foreground="#C9D0E5"/>
                </StackPanel>
                <Border Grid.Column="2" Padding="12,5" Background="#24FFFFFF" CornerRadius="12" VerticalAlignment="Center">
                    <TextBlock x:Name="RoleBadge" Foreground="White" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>
        <TabControl x:Name="Pages" Grid.Row="1" Margin="24,18">
            <TabItem Header="生成客户授权">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="签发资格" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="IssuerStatus" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="客户与授权期限" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="客户名称" Style="{StaticResource Label}"/><TextBox x:Name="CustomerName"/>
                        <TextBlock Text="客户机器码" Style="{StaticResource Label}"/><TextBox x:Name="CustomerMachineCode" FontFamily="Consolas"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="签发日期" Style="{StaticResource Label}"/><DatePicker x:Name="IssueDate" SelectedDateChanged="OnLicenseDateChanged"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="授权期限" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="Duration" SelectionChanged="OnDurationChanged">
                                    <ComboBoxItem Content="1个月" Tag="1"/><ComboBoxItem Content="3个月" Tag="3"/><ComboBoxItem Content="6个月" Tag="6"/>
                                    <ComboBoxItem Content="12个月" Tag="12" IsSelected="True"/><ComboBoxItem Content="24个月" Tag="24"/><ComboBoxItem Content="36个月" Tag="36"/>
                                </ComboBox></StackPanel>
                        </Grid>
                        <TextBlock Text="到期日期" Style="{StaticResource Label}"/><DatePicker x:Name="ExpiryDate"/>
                        <CheckBox x:Name="PermanentCustomer" Margin="0,12,0,0" Content="永久客户授权" Checked="OnPermanentCustomerChanged" Unchecked="OnPermanentCustomerChanged"/>
                        <Button x:Name="GenerateCustomerButton" Margin="0,16,0,0" HorizontalAlignment="Left" Content="生成客户授权码" Style="{StaticResource PrimaryButton}" Click="OnGenerateCustomerLicense"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="授权码" FontSize="18" FontWeight="SemiBold"/>
                        <TextBox x:Name="CustomerToken" Margin="0,10,0,0" Height="150" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal"><Button Content="复制授权码" Click="OnCopyCustomerToken"/>
                            <Button Content="导出 .tjzlic" Click="OnSaveCustomerToken" Margin="0"/></StackPanel>
                    </StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="本机签发员">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="签发员身份" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LocalIssuerStatus" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="签发员姓名" Style="{StaticResource Label}"/><TextBox x:Name="IssuerName"/>
                        <Button x:Name="CreateIssuerButton" Margin="0,12,0,0" HorizontalAlignment="Left" Content="创建签发员申请码" Style="{StaticResource PrimaryButton}" Click="OnCreateIssuerIdentity"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="签发员申请码" FontSize="18" FontWeight="SemiBold"/>
                        <TextBox x:Name="IssuerRequestToken" Margin="0,10,0,0" Height="120" AcceptsReturn="True" TextWrapping="Wrap"/>
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal"><Button Content="复制申请码" Click="OnCopyIssuerRequest"/>
                            <Button Content="导出申请文件" Click="OnSaveIssuerRequest" Margin="0"/></StackPanel>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="导入根管理器签发的永久签发员证书" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBox x:Name="IssuerCertificateToken" Margin="0,10,0,0" Height="120" AcceptsReturn="True" TextWrapping="Wrap"/>
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal"><Button Content="打开证书文件" Click="OnOpenIssuerCertificate"/>
                            <Button Content="导入并启用" Style="{StaticResource PrimaryButton}" Click="OnImportIssuerCertificate" Margin="0"/></StackPanel>
                    </StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem x:Name="RootTab" Header="根授权管理">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="制作方根授权" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="RootStatus" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                        <Button x:Name="AuthorizeLocalButton" Margin="0,12,0,0" HorizontalAlignment="Left" Content="授权本机签发员" Click="OnAuthorizeLocalIssuer"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="签发永久签发员证书" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="签发员申请码" Style="{StaticResource Label}"/><TextBox x:Name="RootRequestToken" Height="100" AcceptsReturn="True" TextWrapping="Wrap"/>
                        <TextBlock Text="客户授权最长天数（1—3660）" Style="{StaticResource Label}"/><TextBox x:Name="MaximumCustomerDays" Text="366"/>
                        <CheckBox x:Name="AllowPermanent" Margin="0,10,0,0" Content="允许该签发员生成永久客户授权"/>
                        <Button x:Name="IssueIssuerButton" Margin="0,14,0,0" HorizontalAlignment="Left" Content="生成永久签发员证书" Style="{StaticResource PrimaryButton}" Click="OnIssueIssuerCertificate"/>
                        <TextBox x:Name="RootCertificateToken" Margin="0,10,0,0" Height="110" AcceptsReturn="True" TextWrapping="Wrap"/>
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal"><Button Content="复制证书" Click="OnCopyRootCertificate"/>
                            <Button Content="导出证书文件" Click="OnSaveRootCertificate" Margin="0"/></StackPanel>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="根密钥加密备份" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="备份密码（至少10个字符）" Style="{StaticResource Label}"/><PasswordBox x:Name="BackupPassword"/>
                        <TextBlock Text="再次输入备份密码" Style="{StaticResource Label}"/><PasswordBox x:Name="BackupPasswordConfirm"/>
                        <Button x:Name="ExportRootBackupButton" Margin="0,12,0,0" HorizontalAlignment="Left" Content="导出 .tjzroot 加密备份" Click="OnExportRootBackup"/>
                        <TextBlock Text="恢复密码" Style="{StaticResource Label}"/><PasswordBox x:Name="RestorePassword"/>
                        <Button x:Name="ImportRootBackupButton" Margin="0,12,0,0" HorizontalAlignment="Left" Content="导入根密钥备份" Click="OnImportRootBackup"/>
                    </StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>
        <Border x:Name="StatusBanner" Grid.Row="2" Background="#E8F2FF" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Margin="24,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#3B5F88"/>
        </Border>
    </Grid>
</Window>
