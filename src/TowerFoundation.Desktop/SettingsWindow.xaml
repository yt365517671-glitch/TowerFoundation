<Window x:Class="TowerFoundation.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 · 塔基智设"
        Width="760"
        Height="860"
        MinWidth="640"
        MinHeight="650"
        Icon="Assets/tower-foundation.ico"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="76" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="SettingsScrollViewer"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                    <Border Width="52"
                            Height="52"
                            Padding="5"
                            Background="White"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <Image x:Name="SettingsLogoImage"
                               Source="Assets/tower-foundation-logo.png"
                               Stretch="Uniform" />
                    </Border>
                    <StackPanel Margin="13,1,0,0" VerticalAlignment="Center">
                        <TextBlock Text="软件设置"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryDarkBrush}" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="文字AI与视觉AI可独立配置；无网或接口异常时仍可完整离线计算。"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <Border x:Name="LicenseCard" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="软件授权" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="LicenseStateText" TextWrapping="Wrap"
                                       Foreground="{StaticResource PrimaryDarkBrush}" FontWeight="SemiBold" />
                            <TextBlock x:Name="LicenseMachineCodeText" Margin="0,7,0,0"
                                       TextWrapping="Wrap" FontFamily="Consolas"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="未授权时可以打开和浏览软件；正式计算、AI识别、保存项目和导出成果均会被统一拦截。" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="ManageLicenseButton"
                                Content="输入 / 更新授权" Margin="18,0,0,0"
                                VerticalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}"
                                Click="ManageLicense_Click" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="运行模式" Style="{StaticResource SectionTitleStyle}" />
                        <RadioButton x:Name="OnlinePreferredRadio"
                                     Content="AI 在线优先（推荐）"
                                     FontWeight="SemiBold"
                                     Margin="0,0,0,6" />
                        <TextBlock Margin="24,0,0,14"
                                   Text="联网且密钥有效时，Word 地勘默认由 DeepSeek 提取候选参数；失败时自动回到手工录入。"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                        <RadioButton x:Name="OfflineOnlyRadio"
                                     Content="纯离线模式（手动切换）"
                                     FontWeight="SemiBold" />
                        <TextBlock Margin="24,6,0,0"
                                   Text="禁止软件发起任何 DeepSeek 请求，项目、计算、优化、保存和成果包仍可使用。"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="地勘视觉大模型 · 阿里云百炼" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="API 地址" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="VisionBaseUrlBox" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="视觉理解模型" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="VisionModelBox"
                                          ToolTip="qwen3.7-plus为持续更新别名；qwen3.7-plus-2026-05-26为固定快照。软件不会静默更换所选模型。" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="每批页数" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="VisionBatchSizeBox"
                                         ToolTip="默认2页；发生超时后软件会自动拆成单页重试，无需手工缩小页码范围" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,14,0,0"
                                   Text="视觉 API 密钥"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <PasswordBox x:Name="VisionApiKeyBox" />
                        <TextBlock x:Name="StoredVisionKeyText"
                                   Margin="0,6,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}" />

                        <Expander x:Name="BailianApiGuideExpander"
                                  Margin="0,12,0,0"
                                  Header="没有百炼 API Key？查看申请步骤">
                            <Border Margin="0,8,0,0"
                                    Padding="14"
                                    Background="#F7F8FF"
                                    BorderBrush="#DFE2F8"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap"
                                               LineHeight="21"
                                               Foreground="#3D465C"
                                               Text="1. 登录阿里云并开通大模型服务平台百炼。&#x0a;2. 在控制台选择实际调用地域和业务空间，进入 API Key 页面创建密钥。&#x0a;3. 确认该业务空间已获所选视觉模型权限；记录创建时显示的 API Key 和对应地域 API Host。&#x0a;4. 将密钥粘贴到上方，或导入业务空间 CSV，然后点击“测试视觉模型”。" />
                                    <TextBlock Margin="0,9,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="{StaticResource WarningBrush}"
                                               Text="百炼按实际调用计费；新创建密钥的完整明文通常只在创建时显示一次。请立即妥善保存，不要发送给他人。" />
                                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                        <Button x:Name="OpenBailianConsoleButton"
                                                Content="打开百炼控制台"
                                                Tag="https://bailian.console.aliyun.com/?tab=model"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="OpenOfficialLink_Click" />
                                        <Button x:Name="OpenBailianApiKeyHelpButton"
                                                Content="查看官方申请说明"
                                                Tag="https://help.aliyun.com/zh/model-studio/get-api-key"
                                                Margin="0"
                                                Click="OpenOfficialLink_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="ImportVisionCsvButton"
                                    Content="导入业务空间CSV"
                                    Click="ImportVisionCsv_Click" />
                            <Button x:Name="TestVisionButton"
                                    Content="测试视觉模型"
                                    Click="TestVisionConnection_Click" />
                            <Button x:Name="ClearVisionButton"
                                    Content="清除视觉密钥"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Margin="0"
                                    Click="ClearVisionApiKey_Click" />
                        </StackPanel>

                        <Border Margin="0,14,0,0"
                                Padding="12"
                                Background="#F3F5FF"
                                CornerRadius="8">
                            <TextBlock TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="默认每批2页、轻量高清图片和150秒视觉专用等待；超时、限流或服务波动时只会在当前模型内自动重试、拆成单页。任何模型切换均先弹窗列出当前模型、建议模型和失败原因，用户确认后才执行。qwen3.7-plus是持续更新别名，qwen3.7-plus-2026-05-26是固定快照。" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="DeepSeek API" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="API 地址" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="BaseUrlBox" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="模型" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="ModelBox"
                                          ToolTip="默认采用 deepseek-v4-pro；需要更低成本时可切换 deepseek-v4-flash" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="超时（秒）" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="TimeoutBox" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,14,0,0"
                                   Text="API 密钥" Style="{StaticResource FieldLabelStyle}" />
                        <PasswordBox x:Name="ApiKeyBox" />
                        <TextBlock x:Name="StoredKeyText"
                                   Margin="0,6,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}" />

                        <Expander x:Name="DeepSeekApiGuideExpander"
                                  Margin="0,12,0,0"
                                  Header="没有 DeepSeek API Key？查看申请步骤">
                            <Border Margin="0,8,0,0"
                                    Padding="14"
                                    Background="#F7F8FF"
                                    BorderBrush="#DFE2F8"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap"
                                               LineHeight="21"
                                               Foreground="#3D465C"
                                               Text="1. 登录 DeepSeek 开放平台，进入 API Keys 页面。&#x0a;2. 创建新密钥并立即复制保存。&#x0a;3. 查看账户余额和当前计费说明，确认账号能够正常调用 API。&#x0a;4. 将密钥粘贴到上方，保持官方 API 地址，然后点击底部“保存并测试”。" />
                                    <TextBlock Margin="0,9,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="{StaticResource WarningBrush}"
                                               Text="DeepSeek API 按实际用量计费。密钥只应粘贴到本机设置中，不要写进项目文件、截图、聊天消息或共享文档。" />
                                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                        <Button x:Name="OpenDeepSeekApiKeysButton"
                                                Content="打开 DeepSeek API Keys"
                                                Tag="https://platform.deepseek.com/api_keys"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="OpenOfficialLink_Click" />
                                        <Button x:Name="OpenDeepSeekApiDocsButton"
                                                Content="查看官方 API 文档"
                                                Tag="https://api-docs.deepseek.com/api/deepseek-api"
                                                Margin="0"
                                                Click="OpenOfficialLink_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <Border Margin="0,16,0,0"
                                Padding="12"
                                Background="#EEF5F7"
                                CornerRadius="5">
                            <TextBlock TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   Text="默认采用 deepseek-v4-pro，可下拉切换 deepseek-v4-flash。密钥使用 Windows DPAPI 按当前 Windows 用户加密，仅保存在本机应用数据目录；不会写入项目、源码、日志或发布 EXE。" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="连接状态" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="TestResultText"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="尚未测试；底部“测试”会检查本机已保存的文字AI与视觉AI配置。" />
                        <StackPanel x:Name="AiProgressPanel"
                                    Margin="0,14,0,0"
                                    Visibility="Collapsed">
                            <TextBlock x:Name="AiProgressText"
                                       Margin="0,0,0,7"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       FontSize="12"
                                       Text="正在连接AI服务…" />
                            <ProgressBar x:Name="AiProgressBar"
                                         Height="8"
                                         IsIndeterminate="True"
                                         Foreground="{StaticResource PrimaryBrush}"
                                         Background="#E5E6FA"
                                         BorderThickness="0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="PDF识别页码范围" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="大型地勘可只识别结论、参数表和建议章节；页码按PDF实际页码填写。结束页为0表示读取到文末，单次最多80页。"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                        <UniformGrid Columns="2" Margin="0,14,0,0">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="开始页" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="OcrStartPageBox" />
                            </StackPanel>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="结束页（0=文末）" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="OcrEndPageBox" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="文件存储位置" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="项目默认保存位置" Style="{StaticResource FieldLabelStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="92" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ProjectDirectoryBox"
                                     VerticalContentAlignment="Center"
                                     ToolTip="新建项目普通保存和项目目录默认使用这里；另存为仍可单独选择位置" />
                            <Button Grid.Column="2"
                                    x:Name="BrowseProjectDirectoryButton"
                                    Content="选择文件夹"
                                    Margin="0"
                                    Click="BrowseProjectDirectory_Click" />
                        </Grid>

                        <TextBlock Margin="0,16,0,0"
                                   Text="资料默认导出位置"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="92" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ExportDirectoryBox"
                                     VerticalContentAlignment="Center"
                                     ToolTip="一键导出的计算书、CAD、材料与工程量默认保存到这里" />
                            <Button Grid.Column="2"
                                    x:Name="BrowseExportDirectoryButton"
                                    Content="选择文件夹"
                                    Margin="0"
                                    Click="BrowseExportDirectory_Click" />
                        </Grid>

                        <TextBlock Margin="0,16,0,0"
                                   Text="地勘分析记录默认保存位置"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="92" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="GeotechnicalHistoryDirectoryBox"
                                     VerticalContentAlignment="Center"
                                     ToolTip="视觉AI、OCR和Word分析结果长期保存在这里；只有主动删除记录时才会移除" />
                            <Button Grid.Column="2"
                                    x:Name="BrowseGeotechnicalHistoryDirectoryButton"
                                    Content="选择文件夹"
                                    Margin="0"
                                    Click="BrowseGeotechnicalHistoryDirectory_Click" />
                        </Grid>

                        <TextBlock Margin="0,16,0,0"
                                   Text="监控杆图纸识别记录默认保存位置"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="92" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="MonitoringDrawingHistoryDirectoryBox"
                                     VerticalContentAlignment="Center"
                                     ToolTip="保存视觉模型、来源文件哈希、页码、字段证据、置信度、冲突、分段横杆和采用时间；再次选择同一PDF时可直接复用" />
                            <Button Grid.Column="2"
                                    x:Name="BrowseMonitoringDrawingHistoryDirectoryButton"
                                    Content="选择文件夹"
                                    Margin="0"
                                    Click="BrowseMonitoringDrawingHistoryDirectory_Click" />
                        </Grid>

                        <Border Margin="0,14,0,0"
                                Padding="12"
                                Background="#F3F5FF"
                                CornerRadius="8">
                            <TextBlock TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="项目、成果、地勘分析记录和监控杆图纸识别记录分别使用上面的默认目录。两类识别记录在切换目录时都会合并已有数据；监控杆记录不保存PDF原图或API密钥，只保存来源文件名与哈希、证据和候选参数。" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ClearButton"
                        Content="清除"
                        Style="{StaticResource DangerButtonStyle}"
                        ToolTip="仅清除塔基智设在本机加密保存的 API 密钥"
                        Click="ClearApiKey_Click" />
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="TestButton"
                            Content="测试"
                            ToolTip="测试本机已经保存的配置，不保存当前修改"
                            Click="TestConnection_Click" />
                    <Button x:Name="SaveAndTestButton"
                            Content="保存并测试"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0"
                            ToolTip="保存当前设置和密钥，然后立即测试连接"
                            Click="SaveAndTest_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
