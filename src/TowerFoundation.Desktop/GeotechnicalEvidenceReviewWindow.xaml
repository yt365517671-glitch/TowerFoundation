<Window x:Class="TowerFoundation.Desktop.GeotechnicalEvidenceReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="地勘原文与AI候选复核"
        Width="1180"
        Height="780"
        MinWidth="980"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="112" />
            <RowDefinition Height="*" />
            <RowDefinition Height="78" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource BrandGradientBrush}">
            <StackPanel Margin="30,0" VerticalAlignment="Center">
                <TextBlock Text="原文与候选并排复核"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold" />
                <TextBlock Margin="0,7,0,0"
                           Text="{Binding ReviewInstruction}"
                           Foreground="#DCE1F4"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24,20,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.12*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="{Binding EvidencePaneTitle}" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding SourceName}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBox Text="{Binding SourceText, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             FontFamily="Microsoft YaHei UI"
                             FontSize="13" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="AI候选字段" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding ReviewSummary}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <DataGrid x:Name="CandidateEvidenceGrid"
                              ItemsSource="{Binding CandidateRows}"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="字段" Width="120" Binding="{Binding Field}" />
                            <DataGridTextColumn Header="候选值" Width="100" Binding="{Binding Value}" />
                            <DataGridTextColumn Header="依据 / 风险" Width="230" Binding="{Binding Evidence}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="26,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="AI候选仍会标记为未人工确认；下一步参数确认弹窗是正式采用门槛。" />
                <Button Grid.Column="1" Width="132" Margin="0,0,10,0" Content="返回手工录入" Click="Cancel_Click" />
                <Button Grid.Column="2" Width="170" Content="采用有依据候选" Style="{StaticResource PrimaryButtonStyle}" Click="Accept_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
