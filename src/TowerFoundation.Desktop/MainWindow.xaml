                                                        <ListBox Grid.Row="1"
                                                                 x:Name="TowerCatalogResultsList"
                                                                 ItemsSource="{Binding FilteredTowerCatalogRecords}"
                                                                 SelectedItem="{Binding SelectedTowerCatalogRecord, Mode=OneWay}"
