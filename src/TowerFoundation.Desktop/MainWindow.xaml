<Window x:Class="TowerFoundation.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="塔基智设 · 铁塔及监控杆基础设计"
        Width="1480"
        Height="920"
        MinWidth="1200"
        MinHeight="760"
        SizeToContent="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="Assets/tower-foundation.ico"
        Closing="MainWindow_Closing"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="84" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Panel.ZIndex="2"
                Background="{StaticResource BrandGradientBrush}">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="50"
                            Height="50"
                            Padding="4"
                            Background="#F8FAFF"
                            BorderBrush="#32FFFFFF"
                            BorderThickness="1"
                            CornerRadius="14">
                        <Image x:Name="AppLogoImage"
                               Source="Assets/tower-foundation-logo.png"
                               Stretch="Uniform" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="塔基智设"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="White" />
                            <Border Margin="14,0,0,0"
                                    Padding="9,3"
                                    CornerRadius="11"
                                    Background="#26FFFFFF"
                                    BorderBrush="#25FFFFFF"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding AiStatusText}"
                                           Foreground="#E7F6F1"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </Border>
                            <Border Margin="8,0,0,0"
                                    Padding="9,3"
                                    CornerRadius="10"
                                    Background="#20FFFFFF"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding ProjectTypeDisplay}"
                                           Foreground="#E3E7F4"
                                           FontSize="12" />
                            </Border>
                            <Border x:Name="LicenseStatusBadge"
                                    Margin="8,0,0,0" Padding="9,3" CornerRadius="10"
                                    Background="#20FFFFFF" VerticalAlignment="Center">
                                <TextBlock x:Name="LicenseStatusText"
                                           Text="开发测试版" Foreground="#E3E7F4" FontSize="12" />
                            </Border>
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0"
                                   Text="双业务入口 · 地勘确认 · 荷载形成 · 三方案优化 · 尺寸复算 · 本地成果"
                                   Foreground="#B8C1D7"
                                   FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="新建" Command="{Binding NewProjectCommand}" Background="#20FFFFFF" BorderBrush="#26FFFFFF" Foreground="White" />
                    <Button Content="打开" Command="{Binding OpenProjectCommand}" Background="#20FFFFFF" BorderBrush="#26FFFFFF" Foreground="White" />
                    <Button Content="保存" Command="{Binding SaveProjectCommand}" Background="#20FFFFFF" BorderBrush="#26FFFFFF" Foreground="White" />
                    <Button Content="另存为" Command="{Binding SaveProjectAsCommand}" Background="#20FFFFFF" BorderBrush="#26FFFFFF" Foreground="White" />
                    <Button x:Name="LicenseButton" Content="授权"
                            Click="OpenLicense_Click" Visibility="Collapsed"
                            Background="#FFF2D6" BorderBrush="#FFF2D6" Foreground="#8A5700" />
                    <Button Content="设置"
                            ToolTip="DeepSeek、在线/离线模式与本机安全配置"
                            Click="OpenSettings_Click"
                            Background="#F4F2FF"
                            BorderBrush="#F4F2FF"
                            Foreground="#343B78"
                            Margin="0" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedStep, Mode=TwoWay}"
                    TabStripPlacement="Left"
                    HorizontalContentAlignment="Stretch"
                    Background="{StaticResource AppBackgroundBrush}"
                    BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Width" Value="232" />
                    <Setter Property="Height" Value="62" />
                    <Setter Property="Margin" Value="14,7,14,0" />
                    <Setter Property="Padding" Value="16,8" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="FontSize" Value="15" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="NavigationBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter x:Name="HeaderPresenter"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      TextElement.Foreground="{StaticResource MutedTextBrush}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="NavigationBorder" Property="Background" Value="#ECEEFA" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="NavigationBorder" Property="Background" Value="White" />
                                        <Setter TargetName="NavigationBorder" Property="BorderBrush" Value="#D7D8FA" />
                                        <Setter TargetName="HeaderPresenter"
                                                Property="TextElement.Foreground"
                                                Value="{StaticResource PrimaryDarkBrush}" />
                                        <Setter TargetName="HeaderPresenter"
                                                Property="TextElement.FontWeight"
                                                Value="SemiBold" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="①  工程类型">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ProjectTypeStepContent"
                                Margin="34,28,36,36"
                                MaxWidth="1100"
                                HorizontalAlignment="Left"
                                IsEnabled="{Binding IsViewingCurrentWorkflowStep}">
                        <TextBlock Text="先选择要设计的工程"
                                   FontSize="28"
                                   FontWeight="Bold" />
                        <TextBlock Margin="0,7,0,24"
                                   Text="两类项目采用不同的荷载形成方式，之后统一进入地勘、基础优化和成果流程。"
                                   Foreground="{StaticResource MutedTextBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="MonitoringProjectCard" Grid.Column="2" Padding="28" CornerRadius="18" BorderThickness="2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMonitoringProject}" Value="True">
                                                <Setter Property="Background" Value="#F4F4FF" />
                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <Border Width="58" Height="58"
                                            Background="#E7E8FF"
                                            CornerRadius="18"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="监"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="监控杆基础"
                                               Margin="0,18,0,8"
                                               FontSize="22"
                                               FontWeight="SemiBold" />
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="适用于道路、园区及视频监控立杆。输入立杆、横杆和设备尺寸，软件自动形成基础端风荷载。" />
                                    <StackPanel Margin="0,18,0,16">
                                        <TextBlock Text="✓ 杆件几何自动计算荷载" Margin="0,0,0,5" />
                                        <TextBlock Text="✓ 省市县级联与规范风压已接入" Margin="0,0,0,5" />
                                        <TextBlock Text="✓ 六种基础形式均可三方案优化" />
                                    </StackPanel>
                                    <Button Content="进入监控杆流程"
                                            Command="{Binding SelectMonitoringProjectCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="TowerProjectCard" Grid.Column="0" Padding="28" CornerRadius="18" BorderThickness="2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTowerProject}" Value="True">
                                                <Setter Property="Background" Value="#F4F4FF" />
                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <Border Width="58" Height="58"
                                            Background="#F1EAFE"
                                            CornerRadius="18"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="塔"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   Foreground="#50558A"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="通信塔桅基础"
                                               Margin="0,18,0,8"
                                               FontSize="22"
                                               FontWeight="SemiBold" />
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="适用于单管塔、三管塔、角钢塔和拉线桅杆。可接企业塔型荷载库，也可录入厂家基础端控制荷载。" />
                                    <StackPanel Margin="0,18,0,16">
                                        <TextBlock Text="✓ 手工基础端荷载已可用" Margin="0,0,0,5" />
                                        <TextBlock x:Name="TowerCatalogAvailabilityText"
                                                   Text="{Binding TowerCatalogAvailabilitySummary}"
                                                   Margin="0,0,0,5" />
                                        <TextBlock Text="✓ 统一基础优化与复算流程" />
                                    </StackPanel>
                                    <Button Content="进入塔桅流程"
                                            Command="{Binding SelectTowerProjectCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Margin="0,22,0,0"
                                Padding="18"
                                Background="#FFF8E8"
                                BorderBrush="#F0D8A7"
                                BorderThickness="1"
                                CornerRadius="7">
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#6F5522"
                                       Text="默认采用 AI 在线优先；无网、API异常或用户手动切换离线时，两类项目仍保留完整手工输入路径，计算内核和项目保存不依赖网络。" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="②  项目与基础">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ProjectStepContent"
                                Margin="34,28,36,36"
                                MaxWidth="1100"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding IsViewingCurrentWorkflowStep}">
                        <TextBlock Text="项目与基础形式"
                                   FontSize="28"
                                   FontWeight="Bold" />
                        <TextBlock Margin="0,7,0,24"
                                   Text="{Binding ProjectTypeDisplay, StringFormat=当前流程：{0}}"
                                   Foreground="{StaticResource PrimaryBrush}" />

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="项目基本信息" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="项目名称" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding Project.Name, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="先选择基础形式" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Margin="0,0,0,14"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="基础形式决定下一步需要读取和确认的地勘字段。刚性短柱桩读取土重度、内摩擦角和分层m值；独立灌注桩读取分层侧阻、端阻、抗拔系数和单桩水平承载力。" />
                                <UniformGrid Columns="3" Rows="2">
                                    <RadioButton GroupName="FoundationType"
                                                 IsChecked="{Binding IsRectangularFoundation, Mode=TwoWay}"
                                                 Style="{StaticResource FoundationTypeCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="独立基础－矩形柱" FontWeight="SemiBold" />
                                            <TextBlock Text="fa / fak · 重度 · 摩擦系数" Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource SuccessBrush}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="FoundationType"
                                                 IsChecked="{Binding IsCircularFoundation, Mode=TwoWay}"
                                                 Style="{StaticResource FoundationTypeCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="独立基础－圆形柱" FontWeight="SemiBold" />
                                            <TextBlock Text="fa / fak · 水位 · 特殊土" Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource SuccessBrush}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="FoundationType"
                                                 IsChecked="{Binding IsRaftFoundation, Mode=TwoWay}"
                                                 Style="{StaticResource FoundationTypeCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="筏板基础" FontWeight="SemiBold" />
                                            <TextBlock Text="持力层 · 软弱下卧层 · 水位" Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource SuccessBrush}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="FoundationType"
                                                 IsChecked="{Binding IsRigidCircularShortPileFoundation, Mode=TwoWay}"
                                                 Style="{StaticResource FoundationTypeCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="刚性短柱桩基础－圆形" FontWeight="SemiBold" />
                                            <TextBlock Text="分层m值 · 抗倾覆 · 圆形配筋" Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource SuccessBrush}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="FoundationType"
                                                 IsChecked="{Binding IsRigidRectangularShortPileFoundation, Mode=TwoWay}"
                                                 Style="{StaticResource FoundationTypeCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="刚性短柱桩基础－矩形" FontWeight="SemiBold" />
                                            <TextBlock Text="X/Y逐向 · 双向偏压 · 矩形配筋" Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource SuccessBrush}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="FoundationType"
                                                 IsChecked="{Binding IsPileFoundation, Mode=TwoWay}"
                                                 Style="{StaticResource FoundationTypeCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="独立灌注桩+连梁" FontWeight="SemiBold" />
                                            <TextBlock Text="1 / 3 / 4根桩 · 无承台" Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource SuccessBrush}" />
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="返回工程类型" Click="GoToTypeStep" />
                            <Button Content="下一步：地勘参数"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="GoToGeotechnicalStep"
                                    Visibility="{Binding IsViewingCurrentWorkflowStep, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="③  地勘参数">
                <ScrollViewer x:Name="GeotechnicalStepScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="GeotechnicalStepContent"
                                Margin="34,28,36,36"
                                MaxWidth="1100"
                                HorizontalAlignment="Left"
                                IsEnabled="{Binding IsViewingCurrentWorkflowStep}">
                        <TextBlock Text="地勘资料与参数确认"
                                   FontSize="28"
                                   FontWeight="Bold" />
                        <TextBlock Margin="0,7,0,24"
                                   Text="智能读取和完整手工录入是并行入口；软件会根据已经选择的基础形式提取不同字段。"
                                   Foreground="{StaticResource MutedTextBrush}" />

                        <Border Padding="12"
                                Margin="0,0,0,14"
                                Background="#F1F1FF"
                                BorderBrush="#D7D8FF"
                                BorderThickness="1"
                                CornerRadius="10">
                            <TextBlock Text="{Binding FoundationTypeDisplay, StringFormat=当前地勘模板：{0}}"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       FontWeight="SemiBold" />
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="建设地点与区域参数"
                                           Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Margin="0,0,0,14"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="地勘识别会优先自动回填省、市、县/区。通信塔桅的地点只用于抗震、特殊土和成果追溯，不重复计算塔脚风荷载；监控杆还会据此匹配基本风压。" />
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="省" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox x:Name="ProvinceBox"
                                                  ItemsSource="{Binding Provinces}"
                                                  SelectedItem="{Binding SelectedProvince, Mode=TwoWay}"
                                                  DisplayMemberPath="Name" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                        <TextBlock Text="市" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox x:Name="CityBox"
                                                  ItemsSource="{Binding Cities}"
                                                  SelectedItem="{Binding SelectedCity, Mode=TwoWay}"
                                                  DisplayMemberPath="Name" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="县 / 区" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox x:Name="CountyBox"
                                                  ItemsSource="{Binding Counties}"
                                                  SelectedItem="{Binding SelectedCounty, Mode=TwoWay}"
                                                  DisplayMemberPath="Name" />
                                    </StackPanel>
                                </Grid>

                                <Border Padding="12"
                                        Margin="0,0,0,14"
                                        Background="#EEF6FF"
                                        BorderBrush="#CFE1FF"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <TextBlock Text="{Binding SeismicLocationSummary}"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource PrimaryDarkBrush}" />
                                </Border>
                                <UniformGrid Columns="4" Margin="0,0,0,8">
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="设防烈度（度）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.Geotechnical.SeismicIntensityDegree, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="基本地震加速度（g）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.Geotechnical.DesignBasicGroundAccelerationG, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="设计地震分组" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.Geotechnical.DesignEarthquakeGroup, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="场地类别（地勘）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.Geotechnical.SiteClass, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>

                                <Border Margin="0,14,0,0"
                                        Padding="14"
                                        Background="#F5F8FA"
                                        CornerRadius="6"
                                        Visibility="{Binding IsMonitoringProject, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="监控杆基本风压" FontWeight="SemiBold" />
                                            <Border Margin="12,0,0,0" Padding="9,3" CornerRadius="9" Background="#EAEAFE">
                                                <TextBlock Text="{Binding WindPressureSourceBadge}"
                                                           Foreground="{StaticResource PrimaryBrush}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Margin="0,8,0,0"
                                                   Text="{Binding WindPressureSummary}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Margin="0,12,0,0"
                                                   Text="必要时人工选择同省参考台站"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox ItemsSource="{Binding ManualWindStations}"
                                                  SelectedItem="{Binding SelectedManualWindStation, Mode=TwoWay}"
                                                  ToolTip="仅提供同省台站人工参考；软件不宣称按坐标自动选取最近台站">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <Run Text="{Binding City}" />
                                                        <Run Text="  ·  50年 " />
                                                        <Run Text="{Binding FiftyYearKpa, StringFormat={}{0:F2}}" />
                                                        <Run Text=" kPa" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="地勘文件智能读取" Style="{StaticResource SectionTitleStyle}" />
                                        <Border Padding="8,2"
                                                Margin="10,1,0,0"
                                                Background="#E8F7F3"
                                                CornerRadius="8"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="视觉AI + OCR + Word" FontSize="11" Foreground="{StaticResource SuccessBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="推荐用视觉大模型直接观察PDF页面和表格；也可使用本机文字层/OCR后再分析，或上传Word。任何云端功能失败时都保留本地OCR和完整手工录入。" />
                                    <TextBlock Margin="0,9,0,0"
                                               Text="{Binding AiStatusDetail}"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="24,0,0,0">
                                    <Button x:Name="VisionGeotechnicalButton"
                                            Content="视觉大模型直接分析 PDF"
                                            Command="{Binding ImportGeotechnicalVisionPdfCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="0,0,0,8" />
                                    <WrapPanel HorizontalAlignment="Right">
                                        <Button Content="本地文字 / OCR"
                                                Command="{Binding ImportGeotechnicalPdfCommand}" />
                                        <Button Content="Word · 文字AI"
                                                Command="{Binding ImportGeotechnicalWordCommand}"
                                                Margin="0" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Padding="14"
                                Margin="0,0,0,14"
                                Background="#F5F6FF"
                                BorderBrush="#D8D9FF"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="270" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="历史地勘分析"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryDarkBrush}" />
                                    <TextBlock Margin="0,4,12,0"
                                               Text="{Binding GeotechnicalHistorySummary}"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                                <ComboBox x:Name="GeotechnicalHistoryComboBox"
                                          Grid.Column="1"
                                          Margin="0,0,12,0"
                                          ItemsSource="{Binding GeotechnicalHistoryRecords}"
                                          SelectedItem="{Binding SelectedGeotechnicalHistoryRecord, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayText"
                                          IsTextSearchEnabled="True"
                                          MaxDropDownHeight="320"
                                          ToolTip="选择以前保存的地勘分析结果；记录只保存在本机" />
                                <Button x:Name="ReuseGeotechnicalHistoryButton"
                                        Grid.Column="2"
                                        Content="引用所选结果"
                                        Command="{Binding ReuseGeotechnicalHistoryCommand}"
                                        Margin="0,0,8,0"
                                        ToolTip="再次弹出证据核对，确认后回填；不会调用AI" />
                                <Button x:Name="ReanalyzeGeotechnicalHistoryButton"
                                        Grid.Column="3"
                                        Content="按当前基础重新分析"
                                        Command="{Binding ReanalyzeGeotechnicalHistoryCommand}"
                                        Margin="0"
                                        ToolTip="使用原文件按当前基础形式重新提取；原文件移动后会请你重新选择" />
                                <Button x:Name="DeleteGeotechnicalHistoryButton"
                                        Grid.Column="4"
                                        Content="删除所选"
                                        Command="{Binding DeleteGeotechnicalHistoryCommand}"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Margin="8,0,0,0"
                                        ToolTip="主动删除这条分析记录；不会删除原地勘文件或改变当前项目" />
                            </Grid>
                        </Border>

                        <Border Padding="14"
                                Margin="0,0,0,14"
                                Background="#EEF5F7"
                                BorderBrush="#C9DDE5"
                                BorderThickness="1"
                                CornerRadius="5">
                            <TextBlock Text="{Binding AiImportSummary}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource PrimaryDarkBrush}" />
                        </Border>

                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{Binding IsShallowFoundation, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="地勘参数 · 自动填入与手工调整" Style="{StaticResource SectionTitleStyle}" />
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,18,14">
                                        <TextBlock Text="修正后地基承载力特征值 fa（kPa）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.Geotechnical.BearingCapacityKpa, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="土重度（kN/m³）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.Geotechnical.SoilUnitWeightKnPerM3, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,18,14">
                                        <TextBlock Text="基底摩擦系数" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.Geotechnical.BaseFrictionCoefficient, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="地下水埋深（m）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.Geotechnical.GroundwaterDepthM, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                                <CheckBox Margin="0,2,0,12"
                                          IsChecked="{Binding Project.Geotechnical.UseBearingCapacityCorrection, Mode=TwoWay}"
                                          FontWeight="SemiBold"
                                          Content="根据 fak 按 GB 50007-2011 式（5.2.4）自动进行基础宽度、埋深修正" />
                                <Border Padding="14"
                                        Margin="0,0,0,14"
                                        Background="#F5F6FF"
                                        BorderBrush="#D8D9FF"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Visibility="{Binding Project.Geotechnical.UseBearingCapacityCorrection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="承载力宽深修正参数"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,10" />
                                        <UniformGrid Columns="3">
                                            <StackPanel Margin="0,0,14,12">
                                                <TextBlock Text="地基承载力特征值 fak（kPa）" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox Text="{Binding Project.Geotechnical.CharacteristicBearingCapacityKpa, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,14,12">
                                                <TextBlock Text="宽度修正系数 ηb" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox Text="{Binding Project.Geotechnical.BearingCapacityWidthCorrectionFactor, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,12">
                                                <TextBlock Text="埋深修正系数 ηd" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox Text="{Binding Project.Geotechnical.BearingCapacityDepthCorrectionFactor, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,14,0">
                                                <TextBlock Text="基底以下土重度 γ（kN/m³）" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox Text="{Binding Project.Geotechnical.SoilBelowBaseUnitWeightKnPerM3, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,14,0">
                                                <TextBlock Text="基底以上加权平均重度 γm（kN/m³）" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox Text="{Binding Project.Geotechnical.SoilAboveBaseAverageUnitWeightKnPerM3, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Text="水位以下应填有效重度；ηb、ηd按地勘土类查表并由设计人员确认。" />
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="土层说明 / 参数来源备注" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding Project.Geotechnical.SoilDescription, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="64"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{Binding IsRigidShortPileFoundation, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="刚性短柱桩地勘参数 · 自动填入与手工调整"
                                           Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Margin="0,0,0,14"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="按主要影响深度录入各土层水平抗力系数m及厚度，并确认土重度、内摩擦角和地下水。软件先计算αh，只有αh≤2.5才允许采用刚性短柱桩模型。" />
                                <UniformGrid Columns="4" Margin="0,0,0,14">
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="土重度 γ（kN/m³）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.Geotechnical.SoilUnitWeightKnPerM3, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="内摩擦角 φ（°）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.Geotechnical.InternalFrictionAngleDegree, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="地下水埋深（m）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.Geotechnical.GroundwaterDepthM, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="侧向抗力宽度系数 ε" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.FoundationSettings.RigidShortPile.LateralResistanceWidthCoefficient, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="地基土水平抗力比例系数m分层（从地面向下）"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,8" />
                                <DataGrid x:Name="RigidShortPileSoilLayerGrid"
                                          ItemsSource="{Binding Project.FoundationSettings.RigidShortPile.SoilLayers}"
                                          IsReadOnly="False"
                                          CanUserAddRows="False"
                                          PreviewMouseWheel="ForwardMouseWheelToPage"
                                          MinHeight="170"
                                          Margin="0,0,0,12">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="土层" Width="*" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTextColumn Header="厚度 hi（m）" Width="160" Binding="{Binding ThicknessM, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTextColumn Header="m（MN/m⁴）" Width="180" Binding="{Binding HorizontalResistanceCoefficientMnPerM4, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="土层说明 / m值来源" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding Project.Geotechnical.SoilDescription, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="64"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{Binding IsMultiLegFoundation, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="多塔柱基础连系梁（所有独立基础型式）" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Margin="0,0,0,12"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="项目统一控制：三管塔按三角形设置3根，四柱角钢塔按四角设置4根周边连系梁；增高架按实际塔柱数确定。这里的3根/4根由塔脚闭合拓扑决定，不是规范按塔型直接给定。共用整体筏板本身已形成整体连接，不重复设置。连系梁内力必须来自塔架-基础整体分析，软件不会从单塔腿反力猜测。" />
                                <Border Margin="0,0,0,14" Padding="12" Background="#EEF6FF" CornerRadius="6">
                                    <TextBlock Text="{Binding PileLayoutSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </Border>
                                <UniformGrid Columns="4">
                                    <StackPanel Margin="0,0,14,14">
                                        <TextBlock Text="基础节点数量（按实际塔柱数）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding PileCountDisplay, Mode=OneWay}" IsReadOnly="True" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,14">
                                        <TextBlock Text="基础中心距 / 连系梁轴线长（m）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.FoundationSettings.Pile.PileCenterSpacingM, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,14">
                                        <TextBlock Text="连系梁宽（m）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.FoundationSettings.Pile.TieBeamWidthM, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="连系梁高（m）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.FoundationSettings.Pile.TieBeamHeightM, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                                <CheckBox Margin="0,0,0,12"
                                          Content="采用经整体受力分析确认的连系梁控制内力"
                                          IsChecked="{Binding Project.FoundationSettings.Pile.UseUserConfirmedTieBeamForces}" />
                                <UniformGrid Columns="4">
                                    <StackPanel Margin="0,0,14,14">
                                        <TextBlock Text="轴向拉力 Nt（kN）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.FoundationSettings.Pile.TieBeamAxialTensionKn, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,14">
                                        <TextBlock Text="弯矩 M（kN·m）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.FoundationSettings.Pile.TieBeamMomentKnM, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,14">
                                        <TextBlock Text="剪力 V（kN）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.FoundationSettings.Pile.TieBeamShearKn, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="纵筋根数 / 直径（mm）" Style="{StaticResource FieldLabelStyle}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Width="82" Text="{Binding Project.FoundationSettings.Pile.TieBeamMainBarCount, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="×" Margin="8,0" VerticalAlignment="Center" />
                                            <TextBox Width="82" Text="{Binding Project.FoundationSettings.Pile.TieBeamMainBarDiameterMm, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="箍筋直径 / 间距（mm）" Style="{StaticResource FieldLabelStyle}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Width="82" Text="{Binding Project.FoundationSettings.Pile.TieBeamStirrupDiameterMm, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="@" Margin="8,0" VerticalAlignment="Center" />
                                            <TextBox Width="82" Text="{Binding Project.FoundationSettings.Pile.TieBeamStirrupSpacingMm, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{Binding IsPileFoundation, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="独立灌注桩地勘参数 · 自动填入与手工调整"
                                           Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Margin="0,0,0,14"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="每个塔腿设置一根独立灌注桩：单管塔1根，三管塔/增高架3根，角钢塔4根；多桩用连梁拉接但不设承台。请按地勘报告录入各层有效厚度、qsik、qpk和抗拔系数；AI只回填报告中明确出现的候选值。" />
                                <UniformGrid Columns="2" Margin="0,0,0,14">
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="地下水埋深（m）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.Geotechnical.GroundwaterDepthM, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="单桩水平承载力（kN）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.FoundationSettings.Pile.SinglePileHorizontalCapacityKn, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock Text="桩土分层（从地面向下）" FontWeight="SemiBold" Margin="0,4,0,8" />
                                <DataGrid x:Name="PileSoilLayerGrid"
                                          ItemsSource="{Binding Project.FoundationSettings.Pile.SoilLayers}"
                                          IsReadOnly="False"
                                          CanUserAddRows="False"
                                          PreviewMouseWheel="ForwardMouseWheelToPage"
                                          MinHeight="220"
                                          Margin="0,0,0,12">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="土层" Width="*" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTextColumn Header="有效厚度（m）" Width="120" Binding="{Binding ThicknessM, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTextColumn Header="侧阻 qsik（kPa）" Width="130" Binding="{Binding SideResistanceKpa, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTextColumn Header="端阻 qpk（kPa）" Width="130" Binding="{Binding TipResistanceKpa, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTextColumn Header="抗拔系数 λ" Width="110" Binding="{Binding UpliftCoefficient, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridCheckBoxColumn Header="砂/碎石类" Width="95" Binding="{Binding IsSandOrGravel, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="土层说明、试桩或参数来源" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding Project.Geotechnical.SoilDescription, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="64"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Button x:Name="GeotechnicalNextButton"
                                Content="下一步：荷载输入"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Click="GoToPoleStep"
                                Visibility="{Binding IsViewingCurrentWorkflowStep, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="④  荷载输入">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch">
                    <StackPanel x:Name="LoadStepContent"
                                Margin="34,28,36,36"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding IsViewingCurrentWorkflowStep}">
                        <TextBlock Text="形成基础端控制荷载"
                                   FontSize="28"
                                   FontWeight="Bold" />
                        <TextBlock Margin="0,7,0,24"
                                   Text="{Binding LoadStepDescription}"
                                   Foreground="{StaticResource MutedTextBrush}" />

                        <StackPanel Visibility="{Binding IsMonitoringProject, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTipService.InitialShowDelay="260"
                                    ToolTipService.ShowDuration="12000">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="风荷载参数" Style="{StaticResource SectionTitleStyle}" />
                                    <UniformGrid Columns="4">
                                        <StackPanel Margin="0,0,14,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="基本风压（kPa）"
                                                           Style="{StaticResource FieldLabelStyle}"
                                                           ToolTip="项目所在地采用的基本风压标准值，单位kPa；本地内核按规范检查0.35kPa下限，并保留风压来源。" />
                                                <Border Margin="8,-2,0,5"
                                                        Padding="7,2"
                                                        CornerRadius="8"
                                                        Background="#EAEAFE">
                                                    <TextBlock Text="{Binding WindPressureSourceBadge}"
                                                               Foreground="{StaticResource PrimaryBrush}"
                                                               FontSize="10" />
                                                </Border>
                                            </StackPanel>
                                            <TextBox Text="{Binding BasicWindPressureKpa, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,14,0">
                                            <TextBlock Text="风振系数 βz" Style="{StaticResource FieldLabelStyle}"
                                                       ToolTip="考虑脉动风及结构动力放大影响的系数，与基本风压、体型系数和高度变化系数相乘形成杆件风压。" />
                                            <TextBox Text="{Binding Project.MonitoringPole.WindVibrationFactor, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,14,0">
                                            <TextBlock Text="体型系数" Style="{StaticResource FieldLabelStyle}"
                                                       ToolTip="将来流风压换算为杆件或设备表面风作用的体型系数，应按截面形式及规范取值确认。" />
                                            <TextBox Text="{Binding Project.MonitoringPole.ShapeCoefficient, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="地形高度系数" Style="{StaticResource FieldLabelStyle}"
                                                       ToolTip="反映地面粗糙度和计算高度对风压的影响，不是杆高或海拔高度本身。" />
                                            <TextBox Text="{Binding Project.MonitoringPole.TerrainHeightFactor, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock Margin="0,10,0,0"
                                               Foreground="{StaticResource WarningBrush}"
                                               FontSize="12"
                                               Text="{Binding WindPressureSummary}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="监控杆施工图视觉识别" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Text="AI只生成带证据的候选；勾选采用后才写入，结构计算始终由本地内核完成。"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button x:Name="MonitoringDrawingVisionButton"
                                                Content="视觉识别监控杆图纸"
                                                Command="{Binding RecognizeMonitoringDrawingsCommand}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                DockPanel.Dock="Right"
                                                HorizontalAlignment="Right"
                                                Margin="18,0,0,0" />
                                    </DockPanel>

                                    <TextBlock Margin="0,4,0,10"
                                               Text="{Binding MonitoringDrawingCandidateSummary}"
                                               Foreground="{StaticResource WarningBrush}"
                                               TextWrapping="Wrap" />
                                    <ComboBox ItemsSource="{Binding MonitoringDrawingCandidates}"
                                              SelectedItem="{Binding SelectedMonitoringDrawingCandidate}"
                                              DisplayMemberPath="DisplayName"
                                              MinWidth="360"
                                              HorizontalAlignment="Left"
                                              Margin="0,0,0,12" />
                                    <DataGrid x:Name="MonitoringDrawingCandidateGrid"
                                              ItemsSource="{Binding SelectedMonitoringDrawingCandidate.Fields}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              MaxHeight="300"
                                              MinHeight="150"
                                              PreviewMouseWheel="ForwardMouseWheelToPage"
                                              Margin="0,0,0,10">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="采用" Width="58">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  ToolTip="单击勾选本字段；图纸未给的字段不会覆盖原值。" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="参数" Width="150" Binding="{Binding DisplayName}" IsReadOnly="True" />
                                            <DataGridTextColumn Header="候选值" Width="145" Binding="{Binding ValueDisplay}" IsReadOnly="True" />
                                            <DataGridTextColumn Header="置信度" Width="75" Binding="{Binding ConfidenceDisplay}" IsReadOnly="True" />
                                            <DataGridTextColumn Header="来源页" Width="65" Binding="{Binding PageNumber}" IsReadOnly="True" />
                                            <DataGridTextColumn Header="原始标注" Width="220" Binding="{Binding RawAnnotation}" IsReadOnly="True" />
