                                    <StackPanel Grid.Column="1" Margin="0,0,14,0"
                                                Visibility="{Binding IsBasePlanRelevant, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="平面Y向尺寸（m）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding CustomBaseWidthM, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,0"
                                                Visibility="{Binding IsCircularPileDiameterRelevant, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="桩径（m）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding CustomPileDiameterM, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,14,0"
                                                Visibility="{Binding IsCircularPileDiameterRelevant, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="桩长 / 埋深（m）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding CustomPileLengthM, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,14,0"
                                                Visibility="{Binding IsRigidRectangularShortPileFoundation, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="埋深（m）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding CustomPileLengthM, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,14,0"
                                                Visibility="{Binding IsBaseThicknessRelevant, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="底板厚（m）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding CustomBaseThicknessM, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <Button Grid.Column="3"
                                            Content="复算自定义尺寸"
                                            Command="{Binding EvaluateCustomSchemeCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            VerticalAlignment="Bottom" />
                                    <Button Grid.Column="4"
                                            Content="采用这个方案"
                                            Command="{Binding AdoptCustomSchemeCommand}"
                                            VerticalAlignment="Bottom"
                                            HorizontalAlignment="Left" />
                                </Grid>
                                <Border Margin="0,16,0,0" Padding="14" Background="#F5F8FA" CornerRadius="5">
                                    <TextBlock Text="{Binding CustomResultSummary}" FontWeight="SemiBold" />
                                </Border>
                                <ItemsControl ItemsSource="{Binding AdjustmentAdvices}" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="12"
                                                    Margin="0,0,0,8"
                                                    Background="White">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Action}" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{StaticResource PrimaryDarkBrush}" />
                                                    <TextBlock Text="{Binding Reason}" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="0,16,0,0" Text="安全性验算" Style="{StaticResource SectionTitleStyle}" />
                                <DataGrid x:Name="CustomChecksGrid"
                                          ItemsSource="{Binding CustomScheme.VerificationChecks}"
                                          PreviewMouseWheel="ForwardMouseWheelToPage"
                                          MinHeight="185"
                                          Margin="0,4,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="校核项" Width="150" Binding="{Binding Name}" />
                                        <DataGridTextColumn Header="状态" Width="85" Binding="{Binding Status, Converter={StaticResource ChineseEnumConverter}}" />
                                        <DataGridTextColumn Header="需求" Width="90" Binding="{Binding DemandDisplay}" />
                                        <DataGridTextColumn Header="能力" Width="90" Binding="{Binding CapacityDisplay}" />
                                        <DataGridTextColumn Header="利用率" Width="90" Binding="{Binding UtilizationDisplay}" />
                                        <DataGridTextColumn Header="规范依据" Width="210" Binding="{Binding RuleReference}" />
                                        <DataGridTextColumn Header="说明" Width="*" Binding="{Binding Explanation}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Margin="0,16,0,0" Text="计算过程结果（不单独判定通过）" Style="{StaticResource SectionTitleStyle}" />
                                <DataGrid ItemsSource="{Binding CustomScheme.CalculatedResults}"
                                          PreviewMouseWheel="ForwardMouseWheelToPage"
                                          MinHeight="100" Margin="0,4,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="结果项" Width="190" Binding="{Binding Name}" />
                                        <DataGridTextColumn Header="计算值" Width="110" Binding="{Binding DemandDisplay}" />
                                        <DataGridTextColumn Header="单位" Width="80" Binding="{Binding Unit}" />
                                        <DataGridTextColumn Header="规范依据" Width="240" Binding="{Binding RuleReference}" />
                                        <DataGridTextColumn Header="说明" Width="*" Binding="{Binding Explanation}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Margin="0,16,0,0" Text="自动处理与专业核对" Style="{StaticResource SectionTitleStyle}" />
                                <DataGrid x:Name="ScopeAndInputGrid"
                                          ItemsSource="{Binding CustomScheme.ScopeAndInputItems}"
                                          PreviewMouseWheel="ForwardMouseWheelToPage"
                                          MinHeight="120" Margin="0,4,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="项目" Width="190" Binding="{Binding Name}" />
                                        <DataGridTextColumn Header="状态" Width="100" Binding="{Binding Status, Converter={StaticResource ChineseEnumConverter}}" />
                                        <DataGridTextColumn Header="依据" Width="260" Binding="{Binding RuleReference}" />
                                        <DataGridTextColumn Header="处理要求" Width="*" Binding="{Binding Explanation}" />
                                        <DataGridTemplateColumn Header="处理" Width="86">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Margin="4" Padding="8,3" Content="补充 / 查看" Click="OpenScopeItem_Click" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Margin="0,16,0,0" Text="施工与交付提醒（不影响当前复算）" Style="{StaticResource SectionTitleStyle}" />
                                <DataGrid x:Name="DeliveryReminderGrid"
                                          ItemsSource="{Binding CustomScheme.DeliveryReminders}"
                                          PreviewMouseWheel="ForwardMouseWheelToPage"
                                          MinHeight="86" Margin="0,4,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="提醒" Width="190" Binding="{Binding Name}" />
                                        <DataGridTextColumn Header="依据" Width="260" Binding="{Binding RuleReference}" />
                                        <DataGridTextColumn Header="说明" Width="*" Binding="{Binding Explanation}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="⑥  成果与记录">
                <ScrollViewer x:Name="OutputStepScrollViewer"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="OutputStepContent"
                                Margin="34,28,36,36"
                                MaxWidth="1100"
                                HorizontalAlignment="Left"
                                IsEnabled="{Binding IsViewingCurrentWorkflowStep}">
                        <TextBlock Text="方案成果与项目记录"
                                   FontSize="28"
                                   FontWeight="Bold" />
                        <TextBlock Margin="0,7,0,24"
                                   Text="项目数据完全保存在本机；完整参数生成正式验算成果，缺少关键参数时仍可导出明确标识的复核稿。"
                                   Foreground="{StaticResource MutedTextBrush}" />

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="已确认方案" Style="{StaticResource SectionTitleStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedScheme.Name, TargetNullValue=尚未选择方案}"
                                                   FontSize="21"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryBrush}" />
                                        <TextBlock Margin="0,6,18,0"
                                                   Text="{Binding SelectedScheme.Description}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                        <Border Margin="0,10,18,0" Padding="10,6" Background="#EEF6FF" CornerRadius="6">
                                            <TextBlock Text="{Binding SelectedScheme.VerificationConclusion}"
                                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="方案尺寸" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding SelectedScheme.GeometrySummary}"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="混凝土" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding SelectedScheme.Quantities.ConcreteM3, StringFormat={}{0:F2} m³}" FontSize="17" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="开挖" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding SelectedScheme.Quantities.ExcavationM3, StringFormat={}{0:F2} m³}" FontSize="17" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="已计算配筋与钢筋量" Style="{StaticResource SectionTitleStyle}" />
                                <DataGrid x:Name="SelectedReinforcementGrid"
                                          ItemsSource="{Binding SelectedScheme.ReinforcementDesigns}"
                                          PreviewMouseWheel="ForwardMouseWheelToPage"
                                          MinHeight="125">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="构件" Width="130" Binding="{Binding Component}" />
                                        <DataGridTextColumn Header="方向" Width="80" Binding="{Binding Direction}" />
                                        <DataGridTextColumn Header="钢筋" Width="125" Binding="{Binding BarSpecification}" />
                                        <DataGridTextColumn Header="计算As" Width="95" Binding="{Binding RequiredAreaMm2, StringFormat={}{0:F0} mm²}" />
                                        <DataGridTextColumn Header="实配As" Width="95" Binding="{Binding ProvidedAreaMm2, StringFormat={}{0:F0} mm²}" />
                                        <DataGridTextColumn Header="总长度" Width="90" Binding="{Binding TotalLengthM, StringFormat={}{0:F2} m}" />
                                        <DataGridTextColumn Header="重量" Width="90" Binding="{Binding CalculatedWeightKg, StringFormat={}{0:F2} kg}" />
                                        <DataGridTextColumn Header="状态" Width="85" Binding="{Binding Status, Converter={StaticResource ChineseEnumConverter}}" />
                                        <DataGridTextColumn Header="规范依据" Width="*" Binding="{Binding RuleReference}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Margin="0,10,0,0"
                                           Foreground="{StaticResource WarningBrush}"
                                           TextWrapping="Wrap"
                                           Text="材料表只汇总上表已经计算的钢筋；短柱、锚栓、构造钢筋以及单桩箍筋、锚固等未验算部分会在导出文件中列为未计量。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="本地项目文件" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{Binding CurrentFileDisplay}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="保存项目" Command="{Binding SaveProjectCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button Content="另存为" Command="{Binding SaveProjectAsCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="过程审计" Style="{StaticResource SectionTitleStyle}" />
                                <DataGrid x:Name="AuditTrailGrid"
                                          ItemsSource="{Binding Project.AuditTrail}"
                                          PreviewMouseWheel="ForwardMouseWheelToPage"
                                          MinHeight="180">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="时间" Width="165" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" />
                                        <DataGridTextColumn Header="操作" Width="190" Binding="{Binding Action}" />
                                        <DataGridTextColumn Header="内容" Width="*" Binding="{Binding Details}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="成果导出" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="一次生成可编辑Word计算书、带企业图签的DXF、钢筋下料表、配筋材料表、工程量、DWG转换脚本和manifest。未完成的专项设计会在每个成果中明确标注。" />
                                <Expander Header="项目图签与出图设置" Margin="0,14,0,0">
                                    <StackPanel Margin="0,12,0,0">
                                        <UniformGrid Columns="4">
                                            <StackPanel Margin="0,0,10,10"><TextBlock Text="设计单位" Style="{StaticResource FieldLabelStyle}" /><TextBox Text="{Binding Project.FoundationSettings.Drawing.CompanyName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                            <StackPanel Margin="10,0,10,10"><TextBlock Text="图名" Style="{StaticResource FieldLabelStyle}" /><TextBox Text="{Binding Project.FoundationSettings.Drawing.DrawingTitle, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                            <StackPanel Margin="10,0,10,10"><TextBlock Text="图号" Style="{StaticResource FieldLabelStyle}" /><TextBox Text="{Binding Project.FoundationSettings.Drawing.DrawingNumber, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                            <StackPanel Margin="10,0,0,10">
                                                <TextBlock Text="比例 / 图幅" Style="{StaticResource FieldLabelStyle}" />
                                                <UniformGrid Columns="2">
                                                    <TextBox Margin="0,0,4,0" Text="{Binding Project.FoundationSettings.Drawing.DrawingScale, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBox Margin="4,0,0,0" Text="{Binding Project.FoundationSettings.Drawing.PaperSize, UpdateSourceTrigger=PropertyChanged}" />
                                                </UniformGrid>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,0"><TextBlock Text="设计" Style="{StaticResource FieldLabelStyle}" /><TextBox Text="{Binding Project.FoundationSettings.Drawing.Designer, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                            <StackPanel Margin="10,0"><TextBlock Text="校核" Style="{StaticResource FieldLabelStyle}" /><TextBox Text="{Binding Project.FoundationSettings.Drawing.Checker, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                            <StackPanel Margin="10,0"><TextBlock Text="审定" Style="{StaticResource FieldLabelStyle}" /><TextBox Text="{Binding Project.FoundationSettings.Drawing.Approver, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                            <StackPanel Margin="10,22,0,0"><CheckBox Content="生成CAD转DWG脚本" IsChecked="{Binding Project.FoundationSettings.Drawing.GenerateDwgConversionScript, Mode=TwoWay}" /></StackPanel>
                                        </UniformGrid>
                                        <TextBlock Margin="0,9,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Text="DXF可直接打开；在已安装AutoCAD/兼容CAD的电脑运行SCR可转存DWG。矩形箍筋已计入135°弯钩量度差及两端弯后平直段；纵筋锚固、接头错开及施工余量仍按最终详图复核。" />
                                    </StackPanel>
                                </Expander>
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button x:Name="ExportAllButton"
                                            Content="一键导出计算书 + CAD + 材料与工程量并打开文件夹"
                                            Command="{Binding ExportPrototypePackageCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button x:Name="ExportAsButton"
                                            Content="导出到其他文件夹"
                                            Command="{Binding ExportPackageAsCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding LastOutputDisplay}"
                                           Margin="0,12,0,0"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="成果使用边界" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{StaticResource WarningBrush}"
                                           Text="成果会逐项区分已验算、计算结果、确需补充的原始资料和已转专业核对事项。静载曲线范围外沉降、未经确认的负摩阻/锚栓模型、特殊地基处理，以及最终锚固搭接、施工偏差和试桩要求，不会被软件自动判为通过；完成这些项目后方可作为正式施工与采购依据。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Panel.ZIndex="2"
                Background="{StaticResource PrimaryDarkBrush}"
                Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="8,3"
                            Margin="0,0,10,0"
                            CornerRadius="9"
                            Background="#2FB18F"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsAiProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="AI 处理中"
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                    </Border>
                    <ProgressBar x:Name="GlobalAiProgressBar"
                                 Grid.Column="1"
                                 Width="210"
                                 Height="8"
                                 Margin="0,0,12,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding AiProgressValue, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsAiProgressIndeterminate, Mode=OneWay}"
                                 Foreground="#6E6AF4"
                                 Background="#55617A"
                                 BorderThickness="0"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsAiProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding StatusMessage}"
                               Foreground="White"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Visibility="{Binding IsViewingCurrentWorkflowStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="流程进度 " Foreground="#C8DEE5" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ProgressText}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="  ·  开发原型，计算不依赖网络" Foreground="#C8DEE5" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Visibility="{Binding IsBrowsingWorkflowStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding WorkflowBrowseSummary}"
                               Margin="0,0,12,0"
                               Foreground="#C8DEE5"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="420" />
                    <Button x:Name="WorkflowReviseButton"
                            Content="从此步骤重新修改"
                            Command="{Binding ReviseViewedWorkflowStepCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="14,7"
                            MinWidth="150"
                            Margin="0,0,10,0"
                            Visibility="{Binding IsBrowsingPastWorkflowStep, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button x:Name="WorkflowReturnButton"
                            Content="回到当前执行流程"
                            Command="{Binding ReturnToCurrentWorkflowCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="14,7"
                            MinWidth="150" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
