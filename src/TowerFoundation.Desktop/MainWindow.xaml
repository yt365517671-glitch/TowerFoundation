                                                <Border Canvas.Left="1440" Canvas.Top="175" Style="{StaticResource ParameterGuideCalloutStyle}"
                                                        ToolTip="立杆钢管母材实际壁厚，不是法兰、加劲板或镀锌层厚度。">
