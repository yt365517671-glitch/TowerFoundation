                                            </Grid>
                                            <Popup x:Name="TowerCatalogResultsPopup"
                                                   Placement="Bottom"
                                                   PlacementTarget="{Binding ElementName=TowerCatalogSearchHost}"
                                                   StaysOpen="False"
                                                   AllowsTransparency="True"
                                                   PopupAnimation="Fade">
                                                <Border x:Name="TowerCatalogResultsBorder"
                                                        Width="{Binding PlacementTarget.ActualWidth, ElementName=TowerCatalogResultsPopup}"
