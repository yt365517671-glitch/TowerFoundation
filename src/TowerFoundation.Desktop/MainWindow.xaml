                                                                 BorderThickness="0"
                                                                 Background="Transparent"
                                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                                 PreviewMouseLeftButtonUp="TowerCatalogResultsList_PreviewMouseLeftButtonUp"
                                                                 PreviewKeyDown="TowerCatalogResultsList_PreviewKeyDown">
                                                            <ListBox.ItemContainerStyle>
                                                                <Style TargetType="ListBoxItem">
                                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                                    <Setter Property="Padding" Value="10,9" />
                                                                    <Setter Property="Margin" Value="0,1" />
                                                                    <EventSetter Event="PreviewMouseLeftButtonUp"
                                                                                 Handler="TowerCatalogResultItem_PreviewMouseLeftButtonUp" />
                                                                </Style>
                                                            </ListBox.ItemContainerStyle>
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding SelectionDisplay}"
                                                                                       FontWeight="SemiBold"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Margin="0,3,0,0"
                                                                                       Text="{Binding SourceDisplay}"
                                                                                       Foreground="{StaticResource MutedTextBrush}"
                                                                                       FontSize="12"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding AvailabilityDisplay}"
                                                                                   Foreground="{StaticResource SuccessBrush}"
                                                                                   FontSize="12"
                                                                                   TextWrapping="Wrap"
                                                                                   VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </Grid>
                                                </Border>
                                            </Popup>
                                            <TextBlock Margin="2,0,0,12"
                                                       FontSize="12"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="输入时自动筛选；多个关键词用空格分隔，例如：20 0.45 6F。选中后搜索框会自动清空，便于继续更换型号。" />

                                            <Border Margin="0,0,0,12"
                                                    Padding="12,10"
                                                    Background="#E9ECFF"
                                                    CornerRadius="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="当前选择"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding SelectedTowerCatalogDisplay}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>

                                            <Border Padding="14"
                                                    Background="White"
                                                    BorderBrush="#E1E4F4"
                                                    BorderThickness="1"
                                                    CornerRadius="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,18,0">
                                                        <TextBlock Text="{Binding TowerCatalogStatus}"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,8,0,0"
                                                                   Text="{Binding SelectedTowerCatalogStandardSummary}"
                                                                   Foreground="{StaticResource SuccessBrush}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Margin="0,4,0,0"
                                                                   Text="{Binding SelectedTowerCatalogBasicSummary}"
                                                                   Foreground="{StaticResource MutedTextBrush}" />
                                                        <TextBlock Margin="0,7,0,0"
                                                                   Text="{Binding SelectedTowerCatalogRecord.ReviewDisplay}"
                                                                   Foreground="{StaticResource WarningBrush}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Content="采用图集塔脚反力"
                                                            Command="{Binding ApplyTowerCatalogLoadCommand}"
                                                            Style="{StaticResource PrimaryButtonStyle}"
                                                            VerticalAlignment="Center"
                                                            Margin="0" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="控制工况名称" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding Project.TowerMast.LoadCaseName, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsTowerCatalogLoad}"
                                             Margin="0,0,0,14" />
                                    <Border Margin="0,0,0,16"
                                            Padding="16"
                                            Background="#EEF6FF"
                                            BorderBrush="#CFE1FF"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Visibility="{Binding IsTowerProject, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding PileLayoutSummary}"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryDarkBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="多腿塔采用相互独立的基础单元时，下列数值必须是一个塔脚的标准组合包络；压力、抗拔和水平验算均采用该组数值，整塔N、V、M不能平均分配。"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding IsMultiLegFoundation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <UniformGrid Columns="3"
                                                         Margin="0,12,0,0"
                                                         Visibility="{Binding IsMultiLegFoundation, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel Margin="0,0,14,0">
                                                    <TextBlock Text="单塔腿最大压力（kN）" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox Text="{Binding Project.TowerMast.IndividualPileCompressionKn, UpdateSourceTrigger=PropertyChanged}"
                                                             IsReadOnly="{Binding IsTowerCatalogLoad}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,14,0">
                                                    <TextBlock Text="单塔腿最大上拔力（kN）" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox Text="{Binding Project.TowerMast.IndividualPileUpliftKn, UpdateSourceTrigger=PropertyChanged}"
                                                             IsReadOnly="{Binding IsTowerCatalogLoad}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="单塔腿最大水平力（kN）" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox Text="{Binding Project.TowerMast.IndividualPileHorizontalKn, UpdateSourceTrigger=PropertyChanged}"
                                                             IsReadOnly="{Binding IsTowerCatalogLoad}" />
                                                </StackPanel>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                    <UniformGrid Columns="3"
                                                 Visibility="{Binding IsMultiLegFoundation, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                        <StackPanel Margin="0,0,14,14">
                                            <TextBlock Text="整塔 / 单管塔竖向压力 N（kN）" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding Project.TowerMast.VerticalKn, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="{Binding IsTowerCatalogLoad}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,14,14">
                                            <TextBlock Text="水平力 Vx（kN）" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding Project.TowerMast.ShearXKn, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="{Binding IsTowerCatalogLoad}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Text="水平力 Vy（kN）" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding Project.TowerMast.ShearYKn, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="{Binding IsTowerCatalogLoad}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,14,0">
                                            <TextBlock Text="弯矩 Mx（kN·m）" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding Project.TowerMast.MomentXKnM, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="{Binding IsTowerCatalogLoad}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,14,0">
                                            <TextBlock Text="弯矩 My（kN·m）" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding Project.TowerMast.MomentYKnM, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="{Binding IsTowerCatalogLoad}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="扭矩 T（kN·m）" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding Project.TowerMast.TorsionKnM, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="{Binding IsTowerCatalogLoad}" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <Border Margin="0,18,0,0"
                                            Padding="16"
                                            Background="#F7F5FF"
                                            BorderBrush="#DCD7FF"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Visibility="{Binding IsTowerManualLoad, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="承载能力极限状态基本组合"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryDarkBrush}" />
                                            <TextBlock Margin="0,5,0,12"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Text="用于基础高度、冲切、受剪、受弯、配筋和材料强度验算。厂家未提供时可全部保留为0，软件将按下方荷载系数推导并在计算书中标明为回退值。" />
                                            <TextBlock Text="基本组合控制工况名称" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding Project.TowerMast.BasicLoadCaseName, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,0,14" />
                                            <UniformGrid Columns="3"
                                                         Visibility="{Binding IsMultiLegFoundation, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel Margin="0,0,14,0">
                                                    <TextBlock Text="基本组合单腿最大压力（kN）" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox Text="{Binding Project.TowerMast.BasicIndividualPileCompressionKn, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,14,0">
                                                    <TextBlock Text="基本组合单腿最大上拔力（kN）" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox Text="{Binding Project.TowerMast.BasicIndividualPileUpliftKn, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="基本组合单腿最大水平力（kN）" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox Text="{Binding Project.TowerMast.BasicIndividualPileHorizontalKn, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </UniformGrid>
                                            <UniformGrid Columns="3"
                                                         Visibility="{Binding IsMultiLegFoundation, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                <StackPanel Margin="0,0,14,14">
                                                    <TextBlock Text="基本组合竖向压力 N（kN）" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox Text="{Binding Project.TowerMast.BasicVerticalKn, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,14,14">
                                                    <TextBlock Text="基本组合水平力 Vx（kN）" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox Text="{Binding Project.TowerMast.BasicShearXKn, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,14">
                                                    <TextBlock Text="基本组合水平力 Vy（kN）" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox Text="{Binding Project.TowerMast.BasicShearYKn, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,14,0">
                                                    <TextBlock Text="基本组合弯矩 Mx（kN·m）" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox Text="{Binding Project.TowerMast.BasicMomentXKnM, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,14,0">
                                                    <TextBlock Text="基本组合弯矩 My（kN·m）" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox Text="{Binding Project.TowerMast.BasicMomentYKnM, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="基本组合扭矩 T（kN·m）" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox Text="{Binding Project.TowerMast.BasicTorsionKnM, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Button x:Name="LoadNextButton"
                                Content="下一步：基础方案与优化"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Click="GoToFoundationStep"
                                Visibility="{Binding IsViewingCurrentWorkflowStep, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="⑤  基础方案">
                <ScrollViewer x:Name="FoundationStepScrollViewer"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="FoundationStepContent"
                                Margin="34,28,36,36"
                                MaxWidth="1140"
                                HorizontalAlignment="Left"
                                IsEnabled="{Binding IsViewingCurrentWorkflowStep}">
                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="基础方案、自动推荐与尺寸复算"
                                           FontSize="28"
                                           FontWeight="Bold" />
                                <TextBlock Margin="0,7,0,0"
                                           Text="本页先确定尺寸搜索范围，再执行自动设计；生成方案后可直接采用推荐方案，或调整尺寸复算。"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                            <Button x:Name="RegenerateSchemesButton"
                                    Grid.Column="1"
                                    Content="重新计算三种方案"
                                    Command="{Binding GenerateSchemesCommand}"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasGeneratedSchemes, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Margin="20,0,0,0" />
                        </Grid>

                        <Expander x:Name="AdvancedDesignParametersExpander"
                                  Header="高级设计参数（一般无需修改）"
                                  IsExpanded="{Binding ShouldExpandAdvancedDesignParameters, Mode=TwoWay}"
                                  Margin="0,0,0,18">
                            <StackPanel Margin="0,12,0,0">
                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{Binding IsShallowFoundation, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="结构设计组合、材料与底筋" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Margin="0,0,0,14"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="图集或厂家已提供基本组合时，软件直接采用基本组合；只有手工资料未提供基本组合时，才使用“标准组合推导系数”作为回退并在计算书中标明。" />
                                <UniformGrid Columns="4">
                                    <StackPanel Margin="0,0,14,14">
                                        <TextBlock Text="标准组合推导系数（回退）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.FoundationSettings.StructuralDesignLoadFactor, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,14">
                                        <TextBlock Text="基础永久作用系数" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.FoundationSettings.FoundationPermanentLoadFactor, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,14">
                                        <TextBlock Text="结构重要性系数 γ0" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.FoundationSettings.StructureImportanceFactor, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="混凝土抗拉强度 ft（MPa）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.FoundationSettings.ConcreteTensileStrengthMpa, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="钢筋强度 fy（MPa）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.FoundationSettings.ReinforcementYieldStrengthMpa, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="保护层（mm）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.FoundationSettings.ConcreteCoverMm, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="底筋直径 / 间距（mm）" Style="{StaticResource FieldLabelStyle}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Width="82" Text="{Binding Project.FoundationSettings.BottomBarDiameterMm, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="@" Margin="8,0" VerticalAlignment="Center" />
                                            <TextBox Width="82" Text="{Binding Project.FoundationSettings.BottomBarSpacingMm, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="最小配筋率（0.0015=0.15%）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.FoundationSettings.MinimumReinforcementRatio, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{Binding IsShallowFoundation, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding FoundationTypeDisplay, StringFormat=尺寸约束与{0}}" Style="{StaticResource SectionTitleStyle}" />
                                <UniformGrid Columns="4">
                                    <StackPanel Margin="0,0,14,14"
                                                Visibility="{Binding IsCircularFoundation, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                        <TextBlock Text="短柱长（m）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.FoundationSettings.PedestalLengthM, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,14"
                                                Visibility="{Binding IsCircularFoundation, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                        <TextBlock Text="短柱宽（m）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.FoundationSettings.PedestalWidthM, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,14"
                                                Visibility="{Binding IsCircularFoundation, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="独立基础圆形柱直径（m）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding PedestalDiameterM, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,14">
                                        <TextBlock Text="短柱高（m）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.FoundationSettings.PedestalHeightM, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="搜索步长（m）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.FoundationSettings.DimensionStepM, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="底板长范围（m）" Style="{StaticResource FieldLabelStyle}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Width="82" Text="{Binding Project.FoundationSettings.MinimumBaseLengthM, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="—" Margin="8,0" VerticalAlignment="Center" />
                                            <TextBox Width="82" Text="{Binding Project.FoundationSettings.MaximumBaseLengthM, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="底板宽范围（m）" Style="{StaticResource FieldLabelStyle}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Width="82" Text="{Binding Project.FoundationSettings.MinimumBaseWidthM, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="—" Margin="8,0" VerticalAlignment="Center" />
                                            <TextBox Width="82" Text="{Binding Project.FoundationSettings.MaximumBaseWidthM, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="底板厚范围（m）" Style="{StaticResource FieldLabelStyle}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Width="82" Text="{Binding Project.FoundationSettings.MinimumBaseThicknessM, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="—" Margin="8,0" VerticalAlignment="Center" />
                                            <TextBox Width="82" Text="{Binding Project.FoundationSettings.MaximumBaseThicknessM, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="抗滑要求安全系数" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.FoundationSettings.RequiredSlidingSafetyFactor, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{Binding IsRigidShortPileFoundation, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="刚性短柱桩设计、搜索与配筋参数" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Margin="0,0,0,14"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="圆形分支保留《单管塔规程计算刚性桩(yy).xls》公式链；矩形分支按JGJ 94第5.7.5条分别计算X、Y向b0、EI、αh和内力，并按GB 50010第6.2.17、6.2.21条校核矩形截面双向偏压。任一方向αh大于2.5均不进入推荐。" />
                                <UniformGrid Columns="3"
                                             Visibility="{Binding IsRigidCircularShortPileFoundation, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Margin="0,0,14,14">
                                        <TextBlock Text="圆形截面直径范围（m）" Style="{StaticResource FieldLabelStyle}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Width="82" Text="{Binding Project.FoundationSettings.RigidShortPile.MinimumDiameterM, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="—" Margin="8,0" VerticalAlignment="Center" />
                                            <TextBox Width="82" Text="{Binding Project.FoundationSettings.RigidShortPile.MaximumDiameterM, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,14">
                                        <TextBlock Text="圆形直径步长（m）" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding Project.FoundationSettings.RigidShortPile.DiameterStepM, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
