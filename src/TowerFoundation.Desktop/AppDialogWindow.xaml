<Window x:Class="TowerFoundation.Desktop.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示"
        Width="560"
        MinHeight="330"
        MaxHeight="600"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="DialogCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="#32FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="#48FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Border Background="White"
                BorderBrush="#E1E5EF"
                BorderThickness="1"
                CornerRadius="24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34"
                                  ShadowDepth="10"
                                  Direction="270"
                                  Opacity="0.25"
                                  Color="#101828" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="112" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="78" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource BrandGradientBrush}"
                        CornerRadius="23,23,0,0"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Margin="28,0,22,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="66" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="38" />
                        </Grid.ColumnDefinitions>

                        <Border Width="50"
                                Height="50"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="#24FFFFFF"
                                BorderBrush="#38FFFFFF"
                                BorderThickness="1"
                                CornerRadius="16">
                            <TextBlock x:Name="IconTextBlock"
                                       Text="!"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       FontSize="25"
                                       FontWeight="Bold" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleTextBlock"
                                       Foreground="White"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="KindTextBlock"
                                       Margin="0,7,0,0"
                                       Foreground="#D7DDF0"
                                       FontSize="13" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="×"
                                ToolTip="关闭"
                                Style="{StaticResource DialogCloseButtonStyle}"
                                Click="Close_Click" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="28,24,28,22">
                    <Border Background="#F7F8FC"
                            BorderBrush="#E7EAF2"
                            BorderThickness="1"
                            CornerRadius="13"
                            Padding="20,17,18,17">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="AccentBar"
                                    Width="4"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource WarningBrush}"
                                    CornerRadius="2" />
                            <ScrollViewer Grid.Column="1"
                                          Margin="14,0,0,0"
                                          MaxHeight="250"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="MessageTextBlock"
                                           TextWrapping="Wrap"
                                           Foreground="#30394D"
                                           FontSize="14"
                                           LineHeight="24" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2"
                        Background="#F8F9FC"
                        BorderBrush="#EBEDF3"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,23,23">
                    <Grid Margin="28,15,28,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="KeyboardHintTextBlock"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"
                                   Text="按 Esc 取消" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="TertiaryActionButton"
                                    MinWidth="92"
                                    Margin="0,0,10,0"
                                    Visibility="Collapsed"
                                    Click="Action_Click" />
                            <Button x:Name="SecondaryActionButton"
                                    MinWidth="112"
                                    Margin="0,0,10,0"
                                    Click="Action_Click" />
                            <Button x:Name="PrimaryActionButton"
                                    MinWidth="122"
                                    Margin="0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="Action_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
