<Window x:Class="TowerFoundation.Desktop.ProjectCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="项目目录"
        Width="940"
        Height="690"
        MinWidth="820"
        MinHeight="590"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown">
    <Grid Margin="24">
        <Border Background="#F7F8FC"
                CornerRadius="24"
                BorderBrush="#E2E6EF"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34"
                                  ShadowDepth="10"
                                  Direction="270"
                                  Opacity="0.24"
                                  Color="#101828" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="126" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource BrandGradientBrush}"
                        CornerRadius="23,23,0,0"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Margin="30,0,22,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <Border Width="54"
                                Height="54"
                                CornerRadius="17"
                                Background="#24FFFFFF"
                                BorderBrush="#38FFFFFF"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left">
                            <TextBlock Text="项"
                                       Foreground="White"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="项目目录"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="25" />
                            <TextBlock Margin="0,7,0,0"
                                       Text="选择项目后双击打开，最近保存的项目排在最前面"
                                       Foreground="#CDD4E8"
                                       FontSize="13" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Width="38"
                                Height="38"
                                Padding="0"
                                Content="×"
                                FontSize="24"
                                Foreground="White"
                                Background="#18FFFFFF"
                                BorderBrush="#20FFFFFF"
                                Click="Cancel_Click" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="30,25,30,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Padding="15,12"
                            CornerRadius="12"
                            Background="White"
                            BorderBrush="#E5E8F0"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="10"
                                    Background="#EBECFF">
                                <TextBlock Text="⌂"
                                           FontSize="18"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="软件默认项目文件夹"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock x:Name="ProjectDirectoryText"
                                           Margin="0,3,0,0"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="2"
                                    Padding="10,5"
                                    CornerRadius="9"
                                    Background="#E9F8F4"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="ProjectCountText"
                                           Foreground="{StaticResource SuccessBrush}"
                                           FontWeight="Bold"
                                           FontSize="12" />
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,18,0,20">
                        <ListBox x:Name="ProjectCatalogList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionMode="Single"
                                 SelectionChanged="ProjectCatalogList_SelectionChanged"
                                 MouseDoubleClick="ProjectCatalogList_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,10" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="IsEnabled" Value="{Binding IsReadable}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder"
                                                        Padding="17,14"
                                                        Background="White"
                                                        BorderBrush="#E5E8F0"
                                                        BorderThickness="1"
                                                        CornerRadius="13">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#AEB1FA" />
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#FAFAFF" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                        <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2" />
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#F4F4FF" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#F5F6F8" />
                                                        <Setter TargetName="ItemBorder" Property="Opacity" Value="0.72" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="210" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42"
                                                Height="42"
                                                CornerRadius="13"
                                                Background="#E9EAFE"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="基"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       FontSize="17"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProjectName}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding ProjectType, Converter={StaticResource ChineseEnumConverter}}"
                                                           Foreground="{StaticResource PrimaryBrush}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12" />
                                                <TextBlock Text="  ·  " Foreground="#A0A7B7" />
                                                <TextBlock Text="{Binding FoundationType, Converter={StaticResource ChineseEnumConverter}}"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="12" />
                                                <TextBlock Text="  ·  " Foreground="#A0A7B7" />
                                                <TextBlock Text="{Binding Location}"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="280" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding ModifiedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                       HorizontalAlignment="Right"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="{Binding FileName}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11"
                                                       HorizontalAlignment="Right"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="205" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border x:Name="EmptyStatePanel"
                                Padding="28"
                                Background="White"
                                BorderBrush="#E5E8F0"
                                BorderThickness="1"
                                CornerRadius="15">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="68" Height="68" CornerRadius="22" Background="#ECEEFA">
                                    <TextBlock Text="＋"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               FontSize="34"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Margin="0,17,0,0"
                                           Text="项目目录还是空的"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="新建项目后点击“保存”，软件会自动放到这里"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="提示：双击项目即可直接打开"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Width="112"
                                Margin="0,0,12,0"
                                Content="取消"
                                Click="Cancel_Click" />
                        <Button x:Name="OpenSelectedButton"
                                Grid.Column="2"
                                Width="150"
                                Content="打开所选项目"
                                IsEnabled="False"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OpenSelected_Click" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
