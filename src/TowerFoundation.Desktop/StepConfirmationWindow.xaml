<Window x:Class="TowerFoundation.Desktop.StepConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="步骤确认"
        Width="620"
        Height="500"
        MinHeight="460"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Border Background="White"
                CornerRadius="24"
                BorderBrush="#E5E8F0"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32"
                                  ShadowDepth="9"
                                  Direction="270"
                                  Opacity="0.24"
                                  Color="#101828" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="126" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource BrandGradientBrush}"
                        CornerRadius="23,23,0,0">
                    <Grid Margin="28,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="52"
                                Height="52"
                                CornerRadius="16"
                                Background="#24FFFFFF"
                                BorderBrush="#32FFFFFF"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left">
                            <TextBlock Text="✓"
                                       Foreground="White"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="24" />
                            <TextBlock Margin="0,7,0,0"
                                       Text="{Binding Subtitle}"
                                       TextWrapping="Wrap"
                                       Foreground="#D5DBEF"
                                       FontSize="13" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="30,23,30,26">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Padding="16,13"
                            CornerRadius="12"
                            Background="#F3F5FF"
                            BorderBrush="#DDE1FF"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="关键参数摘要"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       FontWeight="Bold"
                                       FontSize="12" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding Summary}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       LineHeight="21" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="2,18,2,16">
                        <TextBlock Text="请确认以下内容"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Margin="0,0,0,9" />
                        <ItemsControl ItemsSource="{Binding ConfirmationItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="18"
                                                Height="18"
                                                CornerRadius="9"
                                                Background="#E8F7F0"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="✓"
                                                       Foreground="#148C67"
                                                       FontWeight="Bold"
                                                       FontSize="11"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding}"
                                                   TextWrapping="Wrap"
                                                   Foreground="#3D465C"
                                                   LineHeight="20" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="返回修改"
                                Margin="0,0,8,0"
                                Click="Back_Click" />
                        <Button Grid.Column="1"
                                Content="确认并继续"
                                Margin="8,0,0,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="Confirm_Click" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
