<Window x:Class="TowerFoundation.Desktop.ExitConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="退出确认"
        Width="540"
        Height="390"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Border Background="White"
                CornerRadius="24"
                BorderBrush="#E5E8F0"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32"
                                  ShadowDepth="9"
                                  Direction="270"
                                  Opacity="0.24"
                                  Color="#101828" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="126" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource BrandGradientBrush}"
                        CornerRadius="23,23,0,0">
                    <Grid Margin="28,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="52"
                                Height="52"
                                CornerRadius="16"
                                Background="#24FFFFFF"
                                BorderBrush="#32FFFFFF"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left">
                            <TextBlock Text="↗"
                                       Foreground="White"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="要结束本次设计吗？"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="24" />
                            <TextBlock Margin="0,7,0,0"
                                       Text="关闭软件不会影响已经保存的项目文件"
                                       Foreground="#C8D0E6"
                                       FontSize="13" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="30,24,30,26">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="离开前确认一下"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}" />

                    <Border Grid.Row="1"
                            Margin="0,10,0,18"
                            Padding="16,13"
                            CornerRadius="12"
                            Background="#F7F8FC"
                            BorderBrush="#E8EBF3"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding FileDisplay}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="340" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="若仍有修改，请先返回并点击“保存”"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Padding="9,4"
                                    CornerRadius="9"
                                    Background="#E9EAFE"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding ProgressDisplay}"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           FontWeight="Bold"
                                           FontSize="12" />
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="继续设计"
                                Margin="0,0,8,0"
                                Click="Continue_Click" />
                        <Button Grid.Column="1"
                                Content="确认退出"
                                Margin="8,0,0,0"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="Exit_Click" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
